{
  "name": "moroscope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd backend && uv run python -m app --reload",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "gen:types": "cd backend && uv run python scripts/export_schema.py && cd .. && json2ts -i backend/schema/api.schema.json -o src/types/api.generated.ts --unreachableDefinitions --no-additionalProperties --style.singleQuote --bannerComment \"/* Generated from backend/app/models.py by 'npm run gen:types'. Do not edit. */\"",
    "test": "node --import tsx --test test/*.test.ts",
    "test:api": "cd backend && uv run pytest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
