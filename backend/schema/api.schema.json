            "type": "string"
          },
          "type": "array"
        },
        "sourceUrls": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "maxLength": 4000,
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "type": "string"
        },
        "type": {
          "enum": [
            "keyDate",
            "goodTime",
            "caution"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "date",
        "title",
        "type",
        "lifeAreas",
        "summary",
        "sourceUrls"
