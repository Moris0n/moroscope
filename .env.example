# Copy to .env and fill in. The Python backend (backend/) reads this file.

# Forecast pipeline (all four are required to generate forecasts).
# NEBIUS_MODEL needs a context window of at least 32k tokens: a forecast prompt carries the text
# of the sources (up to about 90,000 characters). Tavily is used only as a fallback.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=
TAVILY_API_KEY=

# Backend port (the Vite dev server on port 3000 proxies /api to it)
PORT=8000

# Optional. Comma-separated Host values the API accepts, e.g. "moroscope.example.com".
# Defaults to localhost on PORT and on the frontend dev port.
# ALLOWED_HOSTS=
# Optional. Bind address (default 127.0.0.1) and profile storage directory (default ./data).
# HOST=
# DATA_DIR=
# Optional. Set to "production" to let the backend serve the built frontend from dist/.
# APP_ENV=
